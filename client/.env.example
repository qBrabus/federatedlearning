# Configuration du client Flower DGX
SERVER_ADDRESS=127.0.0.1:8080
CLIENT_ID=dgx-client
N_LOCAL_EPOCHS=1
BATCH_SIZE=64
LEARNING_RATE=0.01

# TLS/mTLS (optionnel) - renseignez vos chemins montés dans /certs si vous activez TLS
USE_TLS=false
CA_CERT_PATH=/certs/ca.crt
CLIENT_CERT_PATH=/certs/client.crt
CLIENT_KEY_PATH=/certs/client.key
