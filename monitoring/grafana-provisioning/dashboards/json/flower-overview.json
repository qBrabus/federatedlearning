{
  "id": null,
  "uid": "flower-overview",
  "title": "Flower Federated Overview",
  "tags": ["flower", "federated"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU (Client Stack)",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percent"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "right"}, "tooltip": {"mode": "single"}},
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{container=\"fl-clientapp\"}[1m])) * 100",
          "legendFormat": "ClientApp CPU %"
        },
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{container=\"fl-supernode\"}[1m])) * 100",
          "legendFormat": "SuperNode CPU %"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory (Client Stack)",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "right"}, "tooltip": {"mode": "single"}},
      "targets": [
        {
          "expr": "sum(container_memory_usage_bytes{container=\"fl-clientapp\"})",
          "legendFormat": "ClientApp"
        },
        {
          "expr": "sum(container_memory_usage_bytes{container=\"fl-supernode\"})",
          "legendFormat": "SuperNode"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "CPU (Orchestrator & Hub)",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "fieldConfig": {"defaults": {"unit": "percent"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "right"}, "tooltip": {"mode": "single"}},
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{container=\"fl-superlink\"}[1m])) * 100",
          "legendFormat": "Superlink CPU %"
        },
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{container=\"fl-serverapp\"}[1m])) * 100",
          "legendFormat": "ServerApp CPU %"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Memory (Orchestrator & Hub)",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "right"}, "tooltip": {"mode": "single"}},
      "targets": [
        {
          "expr": "sum(container_memory_usage_bytes{container=\"fl-superlink\"})",
          "legendFormat": "Superlink"
        },
        {
          "expr": "sum(container_memory_usage_bytes{container=\"fl-serverapp\"})",
          "legendFormat": "ServerApp"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Network I/O (All Stacks)",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "right"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "expr": "sum by (container) (rate(container_network_receive_bytes_total{container=~\"fl-(clientapp|supernode|superlink|serverapp)\"}[1m]))",
          "legendFormat": "{{container}} RX"
        },
        {
          "expr": "sum by (container) (rate(container_network_transmit_bytes_total{container=~\"fl-(clientapp|supernode|superlink|serverapp)\"}[1m]))",
          "legendFormat": "{{container}} TX"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Hub Control Plane",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 4, "w": 12, "x": 12, "y": 16},
      "fieldConfig": {"defaults": {"unit": "bool"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}},
      "targets": [
        {
          "expr": "up{job=\"flower-hub\"}",
          "legendFormat": "Superlink Control API"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "GPU (Client DGX)",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24},
      "fieldConfig": {"defaults": {"unit": "percent"}, "overrides": [{"matcher": {"id": "byName", "options": "Memory"}, "properties": [{"id": "unit", "value": "bytes"}]}]},
      "options": {"legend": {"displayMode": "list", "placement": "right"}, "tooltip": {"mode": "single"}},
      "targets": [
        {
          "expr": "avg(rate(container_accelerator_duty_cycle{container=\"fl-clientapp\"}[1m]))",
          "legendFormat": "GPU Utilization"
        },
        {
          "expr": "avg(container_accelerator_memory_used_bytes{container=\"fl-clientapp\"})",
          "legendFormat": "Memory"
        }
      ]
    }
  ],
  "templating": {"list": []}
}
